{
  "name": "@aibel365/devops-designsystem",
  "version": "1.2.1",
  "author": "Aibel AS",
  "license": "MIT",
  "description": "React designsystem for Aibel",
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/Aibel365/devops-designsystem",
  "keywords": [
    "React",
    "Aibel",
    "Component library",
    "Styleguide",
    "Designsystem"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": "./dist/index.umd.js"
    },
    "./styles.css": {
      "require": "./dist/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "npm run storybook",
    "build": "npm run clean && tsc -b && vite build && npm run build:css",
    "build:css": "npx @tailwindcss/cli -m -i ./src/tailwind-entry.css -o ./dist/styles.css",
    "storybook": "concurrently \"npm run storybook:css\" \"storybook dev -p 6006\"",
    "storybook:css": "npx @tailwindcss/cli -w -i ./src/tailwind-entry.css -o ./src/assets/index.css",
    "build-storybook": "concurrently \"npm run build-storybook:css\" \"storybook build\"",
    "build-storybook:css": "npx @tailwindcss/cli -m -i ./src/tailwind-entry.css -o ./src/assets/index.css",
    "prepublishOnly": "npm run build",
    "create-design-tokens": "npx @digdir/designsystemet@latest tokens create --config designsystemet.config.json",
    "build-design-tokens": "npx @digdir/designsystemet@latest tokens build --config designsystemet.config.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ./src/components",
    "clean": "rimraf dist storybook-static",
    "knip": "knip"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@digdir/designsystemet-css": "^1.13.1",
    "@digdir/designsystemet-types": "^1.13.1",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^10.3.3",
    "globals": "^16.5.0",
    "knip": "^6.1.1",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "storybook": "^10.3.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@digdir/designsystemet-react": "^1.13.1"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": "0.7.0"
  }
}