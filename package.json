{
  "name": "@aibel365/devops-designsystem",
  "version": "1.24.1",
  "author": "Aibel AS",
  "license": "MIT",
  "description": "React designsystem for Aibel",
  "type": "module",
  "source": "src/index.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.umd.cjs",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/Aibel365/devops-designsystem",
  "keywords": [
    "React",
    "Aibel",
    "Component library",
    "Styleguide",
    "Designsystem"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./fonts.css": "./dist/fonts/fonts.css",
    "./aibel-theme.tailwind.css": "./design-tokens-build/aibel-theme.tailwind.css"
  },
  "files": [
    "dist",
    "design-tokens-build"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "storybook dev -p 6006",
    "clean": "rimraf dist storybook-static",
    "build": "tsc -b && vite build && npm run build:themes",
    "build:themes": "npx @digdir/designsystemet@latest",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ./src/components",
    "knip": "knip"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@digdir/designsystemet-css": "^1.24.0",
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/builder-vite": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "knip": "^6.45.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.7",
    "vite-plugin-svgr": "^5.2.0"
  },
  "dependencies": {
    "@digdir/designsystemet-react": "^1.24.0"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}