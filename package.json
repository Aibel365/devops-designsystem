{
  "name": "@aibel365/devops-designsystem",
  "version": "1.14.0",
  "author": "Aibel AS",
  "license": "MIT",
  "description": "React designsystem for Aibel",
  "type": "module",
  "source": "src/index.ts",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/Aibel365/devops-designsystem",
  "keywords": [
    "React",
    "Aibel",
    "Component library",
    "Styleguide",
    "Designsystem"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": {
      "require": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./aibel-theme.tailwind.css": {
      "style": "./dist/aibel-theme.tailwind.css",
      "default": "./dist/aibel-theme.tailwind.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "npm run storybook",
    "storybook": "concurrently \"npm run tailwind:watch\" \"storybook dev -p 6006\"",
    "tailwind:watch": "npx -y @tailwindcss/cli@latest -w -i ./src/tailwind-entry.css -o ./src/assets/index.css",
    "tailwind:build": "npx -y @tailwindcss/cli@latest -m -i ./src/tailwind-entry.css -o ./dist/styles.css",
    "tailwind:storybook": "npx -y @tailwindcss/cli@latest -m -i ./src/tailwind-entry.css -o ./src/assets/index.css",
    "clean": "rimraf dist storybook-static",
    "build": "npm run clean && tsc -b && vite build && npm run tailwind:build && npm run export-design-tokens",
    "build-storybook": "concurrently \"npm run tailwind:storybook\" \"storybook build\"",
    "prepublishOnly": "npm run build",
    "create-design-tokens": "npx @digdir/designsystemet@latest tokens create --config designsystemet.config.json",
    "build-design-tokens": "npx @digdir/designsystemet@latest tokens build --config designsystemet.config.json --experimental-tailwind",
    "export-design-tokens": "npx @digdir/designsystemet@latest tokens build --config designsystemet.config.json --experimental-tailwind --out-dir dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ./src/components",
    "knip": "knip"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@digdir/designsystemet-css": "^1.14.0",
    "@digdir/designsystemet-types": "^1.13.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.3.6",
    "globals": "^17.6.0",
    "knip": "^6.12.2",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^5.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@digdir/designsystemet-react": "^1.14.0"
  }
}