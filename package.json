{
  "name": "@aibel365/devops-designsystem",
  "version": "1.0.0",
  "author": "Aibel AS",
  "license": "MIT",
  "description": "React designsystem for Aibel",
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/Aibel365/devops-designsystem",
  "keywords": [
    "React",
    "Aibel",
    "Component library",
    "Styleguide",
    "Designsystem"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "start": "npm run storybook",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ./src/components",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-design-tokens": "npx @digdir/designsystemet@latest tokens create --config designsystemet.config.json"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@digdir/designsystemet-types": "^1.9.0",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.1.6",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.6",
    "@storybook/react-vite": "^10.1.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.6",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "storybook": "^10.1.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.9.0",
    "@digdir/designsystemet-react": "^1.9.0"
  }
}
