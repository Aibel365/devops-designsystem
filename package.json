{
  "name": "@aibel365/devops-designsystem",
  "version": "1.0.0-alpha.6",
  "author": "Aibel AS",
  "license": "MIT",
  "description": "React designsystem for Aibel",
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/Aibel365/devops-designsystem",
  "keywords": [
    "React",
    "Aibel",
    "Component library",
    "Styleguide",
    "Designsystem"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": "./dist/index.umd.js"
    },
    "./styles.css": {
      "require": "./dist/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npm run storybook",
    "build": "npm run clean && tsc -b && vite build && npm run build:css",
    "build:css": "npx @tailwindcss/cli -m -i ./src/tailwind-entry.css -o ./dist/styles.css",
    "storybook": "concurrently \"npm run storybook:css\" \"storybook dev -p 6006\"",
    "storybook:css": "npx @tailwindcss/cli -w -i ./src/tailwind-entry.css -o ./src/assets/index.css",
    "build-storybook": "concurrently \"npm run build-storybook:css\" \"storybook build\"",
    "build-storybook:css": "npx @tailwindcss/cli -m -i ./src/tailwind-entry.css -o ./src/assets/index.css",
    "prepublishOnly": "npm run build",
    "create-design-tokens": "npx @digdir/designsystemet@latest tokens create --config designsystemet.config.json",
    "build-design-tokens": "npx @digdir/designsystemet@latest tokens build --config designsystemet.config.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ./src/components",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@digdir/designsystemet-types": "^1.9.0",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.1.6",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.6",
    "@storybook/react-vite": "^10.1.6",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.6",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "storybook": "^10.1.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.24.0",
    "@azure/msal-react": "^3.0.20",
    "@digdir/designsystemet-css": "^1.9.0",
    "@digdir/designsystemet-react": "^1.9.0",
    "@microsoft/applicationinsights-web": "^3.3.10",
    "@tanstack/react-query": "4.43.0",
    "axios": "^1.13.4",
    "react-router-dom": "^7.13.0"
  }
}