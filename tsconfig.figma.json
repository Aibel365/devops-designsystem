{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.figma.tsbuildinfo",
        "target": "es2023",
        "lib": ["ES2023"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["@figma/code-connect/figma-types"],
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src/**/*.figma.ts", "src/figma"]
}
