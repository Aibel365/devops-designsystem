{
  "$schema": "node_modules/@digdir/designsystemet/dist/config.schema.json",
  "outDir": "./design-tokens",
  "themes": {
    "aibel-theme": {
      "colors": {
        "main": {
          "bright-blue": "#0030B0",
          "light-blue": "#C4F0FF",
          "aibel-blue": "#002857"
        },
        "support": {
          "light-green": "#80FFCF",
          "green": "#2E6B3D",
          "light-pink": "#FF9D96",
          "dark-pink": "#BB0059",
          "dark-red": "#5B002E"
        },
        "neutral": "#24272B"
      },
      "overrides": {
        "severity": {
          "info": "#5E8CFF",
          "success": "#2E6B3D",
          "warning": "#EE9000",
          "danger": "#B32A00"
        }
      },
      "borderRadius": 9999
    }
  }
}
