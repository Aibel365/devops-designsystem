        "$type": "color",
        "$value": "{color.danger.16}"
      }
    },
    "focus": {
      "inner": {
        "$type": "color",
        "$value": "{color.focus.inner-color}"
      },
      "outer": {
        "$type": "color",
        "$value": "{color.focus.outer-color}"
      }
    }
  },
  "link": {
    "color": {
      "visited": {
        "$type": "color",
        "$value": "{color.link.visited}"
      }
    }
  }
}
